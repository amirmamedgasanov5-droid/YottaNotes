[
 {
  "key": "x0",
  "who": "X",
  "t": 0.8,
  "end": 3.2,
  "ru": "Пародия. Все персонажи выдуманы.",
  "az": "Parodiya. Bütün personajlar uydurmadır.",
  "scene": "prolog",
  "id": 0
 },
 {
  "key": "v1",
  "who": "V",
  "t": 6.0,
  "end": 11.07,
  "ru": "Хабиб снова победил! Он был так спокоен, что соперник уснул сам.",
  "az": "Xabib yenə qalib gəldi! O, o qədər sakit idi ki, rəqib özü yatdı.",
  "scene": "home",
  "id": 1
 },
 {
  "key": "a1",
  "who": "A",
  "t": 11.75,
  "end": 16.89,
  "ru": "Я тоже хочу в UFC! У меня уже есть и перчатки, и страшный взгляд.",
  "az": "Mən də UFC-yə getmək istəyirəm! Həm əlcəklərim var, həm də qorxulu baxışım.",
  "scene": "home",
  "id": 2
 },
 {
  "key": "m1",
  "who": "M",
  "t": 17.41,
  "end": 19.49,
  "ru": "Амир! Ты уроки сделал?",
  "az": "Amir! Dərslərini etmisən?",
  "scene": "home",
  "id": 3
 },
 {
  "key": "a2",
  "who": "A",
  "t": 19.93,
  "end": 22.07,
  "ru": "Мам, я готовлюсь к бою.",
  "az": "Ana, mən döyüşə hazırlaşıram.",
  "scene": "home",
  "id": 4
 },
 {
  "key": "m2",
  "who": "M",
  "t": 22.51,
  "end": 23.81,
  "ru": "С кем?",
  "az": "Kiminlə?",
  "scene": "home",
  "id": 5
 },
 {
  "key": "a3",
  "who": "A",
  "t": 24.17,
  "end": 25.47,
  "ru": "С Хабибом.",
  "az": "Xabiblə.",
  "scene": "home",
  "id": 6
 },
 {
  "key": "m3",
  "who": "M",
  "t": 25.83,
  "end": 27.26,
  "ru": "А он в курсе?",
  "az": "O xəbərdardır?",
  "scene": "home",
  "id": 7
 },
 {
  "key": "a4",
  "who": "A",
  "t": 27.78,
  "end": 30.49,
  "ru": "Пока нет. Сейчас напишу письмо.",
  "az": "Hələ yox. İndi məktub yazacağam.",
  "scene": "home",
  "id": 8
 },
 {
  "key": "a5",
  "who": "A",
  "t": 31.89,
  "end": 37.32,
  "ru": "Хабиб, давай драться. Адрес: диван. Амир, десять лет. Принеси сменку.",
  "az": "Xabib, gəl döyüşək. Ünvan: divan. Amir, on yaşım var. Dəyişək paltar gətir.",
  "scene": "home",
  "id": 9
 },
 {
  "key": "a6",
  "who": "A",
  "t": 37.84,
  "end": 39.91,
  "ru": "Отправляю самолётиком!",
  "az": "Təyyarəciklə göndərirəm!",
  "scene": "home",
  "id": 10
 },
 {
  "key": "x2",
  "who": "X",
  "t": 42.07,
  "end": 44.47,
  "ru": "Горы. Зал Хабиба.",
  "az": "Dağlar. Xabibin zalı.",
  "scene": "gym",
  "id": 11
 },
 {
  "key": "k1",
  "who": "K",
  "t": 44.99,
  "end": 48.63,
  "ru": "Давай драться. Адрес: диван. Принеси сменку.",
  "az": "Gəl döyüşək. Ünvan: divan. Dəyişək paltar gətir.",
  "scene": "gym",
  "id": 12
 },
 {
  "key": "k2",
  "who": "K",
  "t": 49.39,
  "end": 51.04,
  "ru": "Ребёнок. Хорошо.",
  "az": "Uşaqdır. Yaxşı.",
  "scene": "gym",
  "id": 13
 },
 {
  "key": "k3",
  "who": "K",
  "t": 51.56,
  "end": 54.34,
  "ru": "Миша, сегодня работаем с мелким.",
  "az": "Mişa, bu gün balacayla işləyirik.",
  "scene": "gym",
  "id": 14
 },
 {
  "key": "a7",
  "who": "A",
  "t": 55.58,
  "end": 60.08,
  "ru": "Здравствуйте! Я пришёл вас победить. Только после обеда.",
  "az": "Salam! Mən sizi məğlub etməyə gəlmişəm. Yalnız nahardan sonra.",
  "scene": "gym",
  "id": 15
 },
 {
  "key": "k4",
  "who": "K",
  "t": 60.6,
  "end": 62.39,
  "ru": "Сначала отжимания.",
  "az": "Əvvəlcə sinə üstə əyilmə.",
  "scene": "gym",
  "id": 16
 },
 {
  "key": "a8",
  "who": "A",
  "t": 62.83,
  "end": 64.13,
  "ru": "Сколько?",
  "az": "Neçə dəfə?",
  "scene": "gym",
  "id": 17
 },
 {
  "key": "k5",
  "who": "K",
  "t": 64.49,
  "end": 66.13,
  "ru": "Сколько сможешь.",
  "az": "Nə qədər bacarsan.",
  "scene": "gym",
  "id": 18
 },
 {
  "key": "a9",
  "who": "A",
  "t": 67.85,
  "end": 70.99,
  "ru": "Раз! ...Всё. Я чемпион по отжиманиям.",
  "az": "Bir! ...Bəs. Mən əyilmə çempionuyam.",
  "scene": "gym",
  "id": 19
 },
 {
  "key": "k6",
  "who": "K",
  "t": 71.51,
  "end": 73.09,
  "ru": "Ты сделал одно.",
  "az": "Sən bir dənə etdin.",
  "scene": "gym",
  "id": 20
 },
 {
  "key": "a10",
  "who": "A",
  "t": 73.53,
  "end": 75.6,
  "ru": "Но очень качественное!",
  "az": "Amma çox keyfiyyətli!",
  "scene": "gym",
  "id": 21
 },
 {
  "key": "k7",
  "who": "K",
  "t": 76.12,
  "end": 80.62,
  "ru": "Парная работа. Это Миша. Он вежливый. Главное — не шуми.",
  "az": "Cüt iş. Bu Mişadır. O, tərbiyəlidir. Əsas odur ki, səs-küy salma.",
  "scene": "gym",
  "id": 22
 },
 {
  "key": "a11",
  "who": "A",
  "t": 82.66,
  "end": 83.96,
  "ru": "Он умер?",
  "az": "O öldü?",
  "scene": "gym",
  "id": 23
 },
 {
  "key": "k8",
  "who": "K",
  "t": 84.4,
  "end": 87.04,
  "ru": "Нет. Он увидел твои отжимания.",
  "az": "Xeyr. O, sənin əyilmələrini gördü.",
  "scene": "gym",
  "id": 24
 },
 {
  "key": "k9",
  "who": "K",
  "t": 87.64,
  "end": 90.64,
  "ru": "Теперь захват. Хватай меня за ногу.",
  "az": "İndi tutma. Mənim ayağımdan tut.",
  "scene": "gym",
  "id": 25
 },
 {
  "key": "a12",
  "who": "A",
  "t": 92.2,
  "end": 95.34,
  "ru": "Я не держу! Я просто боюсь отпустить!",
  "az": "Mən tutmuram! Sadəcə buraxmağa qorxuram!",
  "scene": "gym",
  "id": 26
 },
 {
  "key": "k10",
  "who": "K",
  "t": 95.86,
  "end": 99.51,
  "ru": "Для начала сойдёт. И последнее. Папаха силы.",
  "az": "Başlanğıc üçün olar. Və sonuncu. Güc papağı.",
  "scene": "gym",
  "id": 27
 },
 {
  "key": "a13",
  "who": "A",
  "t": 100.91,
  "end": 104.05,
  "ru": "Я ничего не вижу, но я очень сильный!",
  "az": "Heç nə görmürəm, amma çox güclüyəm!",
  "scene": "gym",
  "id": 28
 },
 {
  "key": "v2",
  "who": "V",
  "t": 106.21,
  "end": 111.35,
  "ru": "Срочные новости! Конор Макгрегор вызвал на бой... так... ребёнка.",
  "az": "Təcili xəbər! Conor McGregor döyüşə çağırıb... belə... uşağı.",
  "scene": "news",
  "id": 29
 },
 {
  "key": "v3",
  "who": "V",
  "t": 111.87,
  "end": 116.01,
  "ru": "Мы проверили. Ребёнок существует. Мама подтвердила.",
  "az": "Yoxladıq. Uşaq mövcuddur. Anası təsdiq edib.",
  "scene": "news",
  "id": 30
 },
 {
  "key": "c1",
  "who": "C",
  "t": 116.61,
  "end": 121.83,
  "ru": "Эй, мелкий! Я такой быстрый, что вчера убежал от собственной тени!",
  "az": "Ey, balaca! Mən o qədər sürətliyəm ki, dünən öz kölgəmdən qaçdım!",
  "scene": "news",
  "id": 31
 },
 {
  "key": "c2",
  "who": "C",
  "t": 122.27,
  "end": 124.55,
  "ru": "Она до сих пор меня ищет!",
  "az": "O, hələ də məni axtarır!",
  "scene": "news",
  "id": 32
 },
 {
  "key": "a14",
  "who": "A",
  "t": 125.15,
  "end": 127.44,
  "ru": "Он слишком много говорит.",
  "az": "O, çox danışır.",
  "scene": "news",
  "id": 33
 },
 {
  "key": "k11",
  "who": "K",
  "t": 127.96,
  "end": 130.17,
  "ru": "Пусть. Это его разминка.",
  "az": "Qoy danışsın. Bu, onun isinməsidir.",
  "scene": "news",
  "id": 34
 },
 {
  "key": "c3",
  "who": "C",
  "t": 130.77,
  "end": 135.63,
  "ru": "У меня костюм дороже твоего дома! Хотя... у тебя же есть дом?",
  "az": "Mənim kostyumum sənin evindən bahalıdır! Hərçənd... sənin evin var ki?",
  "scene": "news",
  "id": 35
 },
 {
  "key": "a15",
  "who": "A",
  "t": 136.15,
  "end": 137.79,
  "ru": "Есть! С диваном!",
  "az": "Var! Divanlı!",
  "scene": "news",
  "id": 36
 },
 {
  "key": "c4",
  "who": "C",
  "t": 138.23,
  "end": 139.81,
  "ru": "Диван — слабак!",
  "az": "Divan zəifdir!",
  "scene": "news",
  "id": 37
 },
 {
  "key": "a16",
  "who": "A",
  "t": 140.57,
  "end": 142.78,
  "ru": "Не слушай его, диванчик.",
  "az": "Ona qulaq asma, divançıq.",
  "scene": "news",
  "id": 38
 },
 {
  "key": "x4",
  "who": "X",
  "t": 144.46,
  "end": 146.86,
  "ru": "Взвешивание.",
  "az": "Çəkiyə çıxma.",
  "scene": "weigh",
  "id": 39
 },
 {
  "key": "v4",
  "who": "V",
  "t": 147.38,
  "end": 152.38,
  "ru": "Дамы и господа! Хабиб Нур... Нурмамедов... неважно, все пришли!",
  "az": "Xanımlar və cənablar! Xabib Nur... Nurməmmədov... fərqi yoxdur, hamı gəlib!",
  "scene": "weigh",
  "id": 40
 },
 {
  "key": "r1",
  "who": "R",
  "t": 152.9,
  "end": 154.47,
  "ru": "Конор, на весы.",
  "az": "Conor, tərəziyə.",
  "scene": "weigh",
  "id": 41
 },
 {
  "key": "r2",
  "who": "R",
  "t": 155.71,
  "end": 158.5,
  "ru": "Весы просят вас слезть. Вежливо.",
  "az": "Tərəzi sizdən düşməyi xahiş edir. Nəzakətlə.",
  "scene": "weigh",
  "id": 42
 },
 {
  "key": "c5",
  "who": "C",
  "t": 159.02,
  "end": 160.66,
  "ru": "Это их проблемы!",
  "az": "Bu, onların problemidir!",
  "scene": "weigh",
  "id": 43
 },
 {
  "key": "v5",
  "who": "V",
  "t": 161.18,
  "end": 164.11,
  "ru": "Охранник Гена спит. Это нормально.",
  "az": "Mühafizəçi Gennadi yatır. Bu normaldır.",
  "scene": "weigh",
  "id": 44
 },
 {
  "key": "r3",
  "who": "R",
  "t": 164.87,
  "end": 166.51,
  "ru": "Амир, теперь ты.",
  "az": "Amir, indi sən.",
  "scene": "weigh",
  "id": 45
 },
 {
  "key": "r4",
  "who": "R",
  "t": 167.59,
  "end": 172.95,
  "ru": "Двадцать девять килограммов. Плюс шапка. Плюс бутерброд. Плюс сумка.",
  "az": "İyirmi doqquz kiloqram. Üstəgəl papaq. Üstəgəl sendviç. Üstəgəl çanta.",
  "scene": "weigh",
  "id": 46
 },
 {
  "key": "r5",
  "who": "R",
  "t": 173.47,
  "end": 175.97,
  "ru": "Ладно. Это не вес, это обед.",
  "az": "Yaxşı. Bu çəki deyil, bu nahardır.",
  "scene": "weigh",
  "id": 47
 },
 {
  "key": "a17",
  "who": "A",
  "t": 176.49,
  "end": 179.92,
  "ru": "Мама сказала: без бутерброда не выходить.",
  "az": "Ana dedi: sendvicsiz çıxma.",
  "scene": "weigh",
  "id": 48
 },
 {
  "key": "r6",
  "who": "R",
  "t": 180.52,
  "end": 183.66,
  "ru": "Гляделки. Кто моргнёт — тот проиграл.",
  "az": "Baxış yarışı. Kim göz qırparsa, uduzur.",
  "scene": "weigh",
  "id": 49
 },
 {
  "key": "r7",
  "who": "R",
  "t": 186.34,
  "end": 188.41,
  "ru": "Я моргнул. Я проиграл.",
  "az": "Mən göz qırpdım. Uduzdum.",
  "scene": "weigh",
  "id": 50
 },
 {
  "key": "c6",
  "who": "C",
  "t": 188.93,
  "end": 190.65,
  "ru": "Ты не участвуешь!",
  "az": "Sən iştirak etmirsən!",
  "scene": "weigh",
  "id": 51
 },
 {
  "key": "r8",
  "who": "R",
  "t": 191.17,
  "end": 193.02,
  "ru": "Всё равно проиграл.",
  "az": "Yenə də uduzdum.",
  "scene": "weigh",
  "id": 52
 },
 {
  "key": "x5",
  "who": "X",
  "t": 194.54,
  "end": 196.94,
  "ru": "Арена. Суббота.",
  "az": "Arena. Şənbə.",
  "scene": "fight",
  "id": 53
 },
 {
  "key": "v6",
  "who": "V",
  "t": 197.46,
  "end": 202.18,
  "ru": "В левом углу — Амир... Амирка... Амирчик! В правом — Конор!",
  "az": "Sol küncdə — Amir... Amirka... Amirçik! Sağ küncdə — Conor!",
  "scene": "fight",
  "id": 54
 },
 {
  "key": "g1",
  "who": "G",
  "t": 202.7,
  "end": 204.34,
  "ru": "Что? Уже начали?",
  "az": "Nə? Artıq başladılar?",
  "scene": "fight",
  "id": 55
 },
 {
  "key": "r9",
  "who": "R",
  "t": 204.78,
  "end": 206.08,
  "ru": "Бой!",
  "az": "Döyüş!",
  "scene": "fight",
  "id": 56
 },
 {
  "key": "c7",
  "who": "C",
  "t": 206.68,
  "end": 211.39,
  "ru": "Я тебя поймаю! Я чемпион! Я красивый! У меня костюм! И я...",
  "az": "Mən səni tutacağam! Mən çempionam! Mən gözələm! Kostyumum var! Və mən...",
  "scene": "fight",
  "id": 57
 },
 {
  "key": "a18",
  "who": "A",
  "t": 211.91,
  "end": 213.27,
  "ru": "А долго ещё?",
  "az": "Hələ çoxdur?",
  "scene": "fight",
  "id": 58
 },
 {
  "key": "v7",
  "who": "V",
  "t": 213.79,
  "end": 218.29,
  "ru": "Конор говорит уже минуту! Это рекорд скорости говорения!",
  "az": "Conor artıq bir dəqiqədir danışır! Bu, danışma sürəti rekorddur!",
  "scene": "fight",
  "id": 59
 },
 {
  "key": "c8",
  "who": "C",
  "t": 219.37,
  "end": 221.87,
  "ru": "Мой галстук! Он итальянский!",
  "az": "Mənim qalstukum! O, italyandır!",
  "scene": "fight",
  "id": 60
 },
 {
  "key": "c9",
  "who": "C",
  "t": 222.39,
  "end": 225.46,
  "ru": "Судья! Медведь — это не по правилам!",
  "az": "Hakim! Ayı qaydalara uyğun deyil!",
  "scene": "fight",
  "id": 61
 },
 {
  "key": "r10",
  "who": "R",
  "t": 225.98,
  "end": 230.63,
  "ru": "В правилах про медведей ничего нет. Я проверял. Я их съел.",
  "az": "Qaydalarda ayılar haqqında heç nə yoxdur. Yoxladım. Mən onları yemişəm.",
  "scene": "fight",
  "id": 62
 },
 {
  "key": "r11",
  "who": "R",
  "t": 231.39,
  "end": 233.17,
  "ru": "Минуточку. Шнурок.",
  "az": "Bir dəqiqə. Ayaqqabı bağı.",
  "scene": "fight",
  "id": 63
 },
 {
  "key": "c10",
  "who": "C",
  "t": 234.57,
  "end": 236.29,
  "ru": "Бутерброд будешь?",
  "az": "Sendviç yeyərsən?",
  "scene": "fight",
  "id": 64
 },
 {
  "key": "a19",
  "who": "A",
  "t": 236.73,
  "end": 238.03,
  "ru": "С чем?",
  "az": "Nəylə?",
  "scene": "fight",
  "id": 65
 },
 {
  "key": "c11",
  "who": "C",
  "t": 238.39,
  "end": 239.69,
  "ru": "С колбасой.",
  "az": "Kolbasalı.",
  "scene": "fight",
  "id": 66
 },
 {
  "key": "a20",
  "who": "A",
  "t": 240.05,
  "end": 241.35,
  "ru": "Давай.",
  "az": "Ver.",
  "scene": "fight",
  "id": 67
 },
 {
  "key": "v8",
  "who": "V",
  "t": 242.03,
  "end": 245.95,
  "ru": "Бойцы делят бутерброд! Такого в UFC ещё не было!",
  "az": "Döyüşçülər sendviçi bölürlər! UFC-də belə hal olmayıb!",
  "scene": "fight",
  "id": 68
 },
 {
  "key": "k12",
  "who": "K",
  "t": 246.55,
  "end": 249.2,
  "ru": "Амир! Делай то, что я говорил!",
  "az": "Amir! Dediyimi et!",
  "scene": "fight",
  "id": 69
 },
 {
  "key": "a21",
  "who": "A",
  "t": 249.64,
  "end": 251.71,
  "ru": "Вы ничего не говорили!",
  "az": "Siz heç nə deməmişdiniz!",
  "scene": "fight",
  "id": 70
 },
 {
  "key": "k13",
  "who": "K",
  "t": 252.15,
  "end": 255.01,
  "ru": "Значит, делай то, что не говорил!",
  "az": "Deməli, deməyəni et!",
  "scene": "fight",
  "id": 71
 },
 {
  "key": "a22",
  "who": "A",
  "t": 255.45,
